"""ignitem_ctl: drive a running IGNITE emulator (started with `ignitem run`).

    ignitem_ctl press NAME [MS]     a key, pad or knob push, held MS ms (default 120)
    ignitem_ctl down NAME | up NAME
    ignitem_ctl turn NAME STEPS     an encoder (A..H, ENC 1..16, JOG, ROW, BAR); STEPS signed
    ignitem_ctl shot OUT.png [SCALE]
    ignitem_ctl list | lit | link

The run is found through ~/.cache/ignitem/run/state.json (or $IGNITEM_RUN_DIR).
"""
import json, os, re, sys, time

RUN = os.environ.get("IGNITEM_RUN_DIR") or os.path.expanduser("~/.cache/ignitem/run")

def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
        print(__doc__); return 2
    try:
        st = json.load(open(os.path.join(RUN, "state.json")))
    except OSError:
        print("ignitem_ctl: no run (start one with: ignitem run)", file=sys.stderr); return 1
    ctl, log = st["control"], st["panel_log"]
    seqf = ctl + ".seq"
    seq = int(open(seqf).read() or 0) + 1 if os.path.exists(seqf) else 1
    open(seqf, "w").write(str(seq))
    start = os.path.getsize(log) if os.path.exists(log) else 0
    with open(ctl, "a") as f:
        f.write(f"{seq} {' '.join(sys.argv[1:])}\n")
    pat = re.compile(rf"^PanelControl: (ok|error) {seq}\b ?(.*)$", re.M)
    end = time.time() + float(os.environ.get("IGNITEM_CTL_TIMEOUT", "15"))
    while time.time() < end:
        with open(log) as f:
            f.seek(start)
            m = pat.search(f.read())
        if m:
            if m.group(1) == "error":
                print("ignitem_ctl: " + m.group(2), file=sys.stderr); return 1
            try:
                out = open(ctl + ".reply").read()
            except OSError:
                out = ""
            if out: print(out, end="")
            return 0
        time.sleep(0.03)
    print("ignitem_ctl: no answer", file=sys.stderr); return 1

sys.exit(main())
