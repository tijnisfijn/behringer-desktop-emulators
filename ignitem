#!/usr/bin/env python3
# SPDX-License-Identifier: AGPL-3.0-or-later
"""ignitem: run Behringer's IGNITE app (0716-AAF) against an emulated front panel.

    ignitem fetch   [--firmware URL|PATH] [--ref BRANCH]   clone the IGNITE source and apply ../patches
    ignitem build   [--firmware ...]                      build the IGNITE app and the panel
    ignitem run     [--firmware ...] [--app PATH] [--detach]
                                                          build what is missing, start the panel and the app
    ignitem stop                                          stop a run
    ignitem status

The panel makes a pty; the app opens it through IGNITE_FP_TTY (patches/0001). Drive a run with
tools/ignitem_ctl. Everything is kept in ~/.cache/ignitem (or $IGNITEM_CACHE).
"""
import argparse, json, os, re, shutil, signal, struct, subprocess, sys, time

HERE = os.path.dirname(os.path.abspath(__file__))
CACHE = os.environ.get("IGNITEM_CACHE") or os.path.expanduser("~/.cache/ignitem")
RUN = os.path.join(CACHE, "run")
DEFAULT_FIRMWARE = "https://github.com/MusicTribeOpenSource/0716-AAF.git"
SOUNDFONT = "/tmp/Ignite.sf2"  # where the macOS build of the app looks (ModelParams.h, SOUND_FONT_FILE)
ENV_BUILD = dict(os.environ, MACOSX_DEPLOYMENT_TARGET="11.0")


def say(msg):
    print("ignitem: " + msg, flush=True)


def die(msg):
    say(msg)
    sys.exit(1)


def sh(cmd, cwd=None, log=None, env=None):
    with open(log, "a") if log else open(os.devnull, "w") as out:
        r = subprocess.run(cmd, cwd=cwd, stdout=out, stderr=subprocess.STDOUT, env=env or ENV_BUILD)
    if r.returncode:
        die(f"failed: {' '.join(cmd)}" + (f" (see {log})" if log else ""))


# ---- the firmware source

def firmware_dir(args):
    if args.firmware and os.path.isdir(args.firmware):
        return os.path.abspath(args.firmware)
    return os.path.join(CACHE, "firmware", "0716-AAF")


def fetch(args):
    fw = firmware_dir(args)
    if not os.path.isdir(fw):
        os.makedirs(os.path.dirname(fw), exist_ok=True)
        say(f"fetching {args.firmware or DEFAULT_FIRMWARE} ({args.ref})")
        sh(["git", "clone", "--depth", "1", "--branch", args.ref, args.firmware or DEFAULT_FIRMWARE, fw])
    for p in sorted(os.listdir(os.path.join(HERE, "patches"))):
        path = os.path.join(HERE, "patches", p)
        if subprocess.run(["git", "apply", "--reverse", "--check", path], cwd=fw, capture_output=True).returncode == 0:
            continue  # already applied
        if subprocess.run(["git", "apply", "--check", path], cwd=fw, capture_output=True).returncode:
            die(f"patch {p} does not apply to {fw}")
        sh(["git", "apply", path], cwd=fw)
        say(f"applied {p}")
    return fw


def silent_soundfont(path):
    """A minimal valid SoundFont 2 with one silent sample: the app needs one to start, and the real one
    (Ignite.sf2) is not part of Behringer's release."""
    def chunk(tag, data):
        if len(data) % 2:
            data += b"\0"
        return tag + struct.pack("<I", len(data)) + data
    def lst(tag, *chunks):
        body = tag + b"".join(chunks)
        return b"LIST" + struct.pack("<I", len(body)) + body
    def name20(s):
        return s.encode()[:19].ljust(20, b"\0")
    n = 200
    info = lst(b"INFO", chunk(b"ifil", struct.pack("<HH", 2, 1)), chunk(b"isng", b"EMU8000\0"), chunk(b"INAM", b"Silent\0"))
    sdta = lst(b"sdta", chunk(b"smpl", b"\0\0" * (n + 46)))
    phdr = name20("Silent") + struct.pack("<HHHIII", 0, 0, 0, 0, 0, 0) + name20("EOP") + struct.pack("<HHHIII", 0, 0, 1, 0, 0, 0)
    bag = struct.pack("<HH", 0, 0) + struct.pack("<HH", 1, 0)
    pgen = struct.pack("<HH", 41, 0) + struct.pack("<HH", 0, 0)
    inst = name20("Silent") + struct.pack("<H", 0) + name20("EOI") + struct.pack("<H", 1)
    igen = struct.pack("<HH", 53, 0) + struct.pack("<HH", 0, 0)
    shdr = name20("Silence") + struct.pack("<IIIIIBbHH", 0, n, 10, n - 10, 22050, 60, 0, 0, 1) + name20("EOS") + b"\0" * 26
    pdta = lst(b"pdta", chunk(b"phdr", phdr), chunk(b"pbag", bag), chunk(b"pmod", b"\0" * 10), chunk(b"pgen", pgen),
               chunk(b"inst", inst), chunk(b"ibag", bag), chunk(b"imod", b"\0" * 10), chunk(b"igen", igen), chunk(b"shdr", shdr))
    body = b"sfbk" + info + sdta + pdta
    with open(path, "wb") as f:
        f.write(b"RIFF" + struct.pack("<I", len(body)) + body)


# ---- building

def app_path():
    return os.path.join(CACHE, "build", "app", "apps", "ignite", "Ignite_artefacts", "Release", "Ignite.app", "Contents", "MacOS", "Ignite")


def panel_path():
    return os.path.join(CACHE, "build", "panel", "ignite-panel_artefacts", "Release", "IGNITE panel.app", "Contents", "MacOS", "IGNITE panel")


def build(args):
    fw = fetch(args)
    os.makedirs(os.path.join(CACHE, "logs"), exist_ok=True)
    log = os.path.join(CACHE, "logs", "build.log")
    if not args.app:
        say("building the IGNITE app (the first time takes a while)")
        b = os.path.join(CACHE, "build", "app")
        sh(["cmake", "-S", os.path.join(fw, "Source", "Application"), "-B", b, "-DCMAKE_BUILD_TYPE=Release",
            "-DCMAKE_OSX_DEPLOYMENT_TARGET=11.0", "-DCMAKE_POLICY_VERSION_MINIMUM=3.5"], log=log)
        sh(["cmake", "--build", b, "--config", "Release", "--target", "Ignite", "-j", str(os.cpu_count() or 4)], log=log)
    say("building the panel")
    b = os.path.join(CACHE, "build", "panel")
    cfg = ["cmake", "-S", HERE, "-B", b, "-DCMAKE_BUILD_TYPE=Release", "-DCMAKE_OSX_DEPLOYMENT_TARGET=11.0"]
    if os.environ.get("IGNITEM_JUCE"):
        cfg.append("-DFETCHCONTENT_SOURCE_DIR_JUCE=" + os.environ["IGNITEM_JUCE"])
    sh(cfg, log=log)
    sh(["cmake", "--build", b, "--config", "Release", "-j", str(os.cpu_count() or 4)], log=log)


# ---- running

def state():
    try:
        return json.load(open(os.path.join(RUN, "state.json")))
    except OSError:
        return None


def alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except (OSError, TypeError):
        return False


def wait_for(path, pattern, seconds, proc=None):
    rx = re.compile(pattern)
    end = time.time() + seconds
    while time.time() < end:
        if os.path.exists(path):
            m = rx.search(open(path, errors="replace").read())
            if m:
                return m
        if proc and proc.poll() is not None:
            return None
        time.sleep(0.1)
    return None


def stop(_args=None):
    st = state()
    if not st:
        return say("nothing is running")
    for k in ("app_pid", "panel_pid"):
        if alive(st.get(k)):
            os.kill(st[k], signal.SIGTERM)
    time.sleep(0.8)
    for k in ("app_pid", "panel_pid"):
        if alive(st.get(k)):
            os.kill(st[k], signal.SIGKILL)
    os.remove(os.path.join(RUN, "state.json"))
    say("stopped the IGNITE app and the panel")


def run(args):
    st = state()
    if st and (alive(st.get("app_pid")) or alive(st.get("panel_pid"))):
        die("a run is going: ignitem stop first")
    app = os.path.abspath(args.app) if args.app else app_path()
    if not os.path.exists(app) or not os.path.exists(panel_path()):
        build(args)
    if not os.path.exists(SOUNDFONT):
        silent_soundfont(SOUNDFONT)
        say(f"wrote a silent SoundFont to {SOUNDFONT} (the app needs one to start)")
    os.makedirs(RUN, exist_ok=True)
    ctl, plog, alog, sock = (os.path.join(RUN, n) for n in ("panel.ctl", "panel.log", "ignite.log", "screen.sock"))
    for f in (ctl, plog, alog, ctl + ".seq", ctl + ".reply", sock):
        if os.path.exists(f):
            os.remove(f)
    open(ctl, "w").close()
    panel = subprocess.Popen([panel_path(), "--control", ctl, "--screen", "unix:" + sock], stdout=open(plog, "w"), stderr=subprocess.STDOUT, start_new_session=True)
    m = wait_for(plog, r"IgnitePanel: listening on (\S+)", 15, panel)
    if not m:
        die(f"the panel did not start (see {plog})")
    tty = m.group(1)
    say(f"panel on {tty}")
    proc = subprocess.Popen([app], cwd=os.path.dirname(app), env=dict(os.environ, IGNITE_FP_TTY=tty, IGNITE_SCREEN_MIRROR=sock),
                            stdout=open(alog, "w"), stderr=subprocess.STDOUT, start_new_session=True)
    json.dump({"panel_pid": panel.pid, "app_pid": proc.pid, "tty": tty, "control": ctl, "panel_log": plog, "app_log": alog, "screen": sock,
               "app": app, "started": time.time()}, open(os.path.join(RUN, "state.json"), "w"), indent=1)
    if not wait_for(plog, r"IgnitePanel: LIVE", 30, proc):
        say(f"no handshake yet (see {plog} and {alog})")
    else:
        say("LIVE: the app and the panel are talking")
    if args.detach:
        return
    say("running; Ctrl-C stops both")
    try:
        while proc.poll() is None and panel.poll() is None:
            time.sleep(0.5)
    except KeyboardInterrupt:
        pass
    stop()


def status(_args):
    st = state()
    if not st:
        return say("nothing is running")
    for k in ("panel_pid", "app_pid"):
        print(f"{k:10} {st[k]} {'running' if alive(st[k]) else 'gone'}")
    for k in ("tty", "control", "panel_log", "app_log", "app"):
        print(f"{k:10} {st[k]}")


def main():
    p = argparse.ArgumentParser(description="Run Behringer's IGNITE app against an emulated front panel.")
    sub = p.add_subparsers(dest="cmd", required=True)
    for name in ("fetch", "build", "run"):
        s = sub.add_parser(name)
        s.add_argument("--firmware", help="a git URL or a local checkout of 0716-AAF (default: MusicTribeOpenSource)")
        s.add_argument("--ref", default="main")
        s.add_argument("--app", help="use this IGNITE app binary instead of building one")
        if name == "run":
            s.add_argument("--detach", action="store_true", help="leave both running and return")
    sub.add_parser("stop")
    sub.add_parser("status")
    a = p.parse_args()
    {"fetch": fetch, "build": build, "run": run, "stop": stop, "status": status}[a.cmd](a)


if __name__ == "__main__":
    main()
